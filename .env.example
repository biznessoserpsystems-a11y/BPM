DATABASE_URL=file:../db/custom.db

# Generate a unique value for every deployment — never reuse the one from
# .env in this repo, and never commit a real one to version control.
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Encrypts employee payroll PII (SSNIT number, TIN, bank account) at
# rest. Same rule as above — a unique value per deployment, generated
# the same way, never reused or committed.
FIELD_ENCRYPTION_KEY=

# Optional: enables the seller-facing license admin panel at
# /admin/licenses and its API (src/app/api/v1/admin/license-tokens).
# Leave unset to disable that panel entirely (it responds 503 without
# this). Separate from JWT_SECRET/tenant login on purpose — this lets
# whoever operates the deployment mint license tokens without any
# pharmacy admin account being able to. Generate the same way as the
# secrets above; must be at least 24 characters.
LICENSE_ADMIN_SECRET=
