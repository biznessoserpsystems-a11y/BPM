DATABASE_URL=file:../db/custom.db

# Generate a unique value for every deployment — never reuse the one from
# .env in this repo, and never commit a real one to version control.
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Encrypts employee payroll PII (SSNIT number, TIN, bank account) at
# rest. Same rule as above — a unique value per deployment, generated
# the same way, never reused or committed.
FIELD_ENCRYPTION_KEY=
